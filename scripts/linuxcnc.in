import atexit
import getopt
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time


EMC2_HOME            = "@EMC2_HOME@"
EMC2_BIN_DIR         = "@EMC2_BIN_DIR@"
EMC2_TCL_DIR         = "@EMC2_TCL_DIR@"
EMC2_TCL_LIB_DIR     = "@EMC2_TCL_LIB_DIR@"
EMC2_HELP_DIR        = "@EMC2_HELP_DIR@"
EMC2_RTLIB_DIR       = "@EMC2_RTLIB_DIR@"
EMC2_NCFILES_DIR     = "@EMC2_NCFILES_DIR@"
EMC2_LANG_DIR        = "@EMC2_LANG_DIR@"
EMC2_IMAGE_DIR       = "@EMC2_IMAGE_DIR@"
LINUXCNC_CONFIG_PATH = "@LINUXCNC_CONFIG_PATH@"
HALLIB_DIR           = "@HALLIB_DIR@"

REALTIME             = "@REALTIME@"
MODULE_EXT           = "@MODEXT@"
WISH                 = "@WISH@"
TCLSH                = "@TCLSH@"
KERNEL_VERS          = "@KERNEL_VERS@"
DEFAULT_NMLFILE      = "@DEFAULT_NMLFILE@"
LINUXCNCVERSION      = "@EMC2VERSION@"

PIDOF_BIN            = "@PIDOF@"
PS_BIN               = "@PS@"
AWK_BIN              = "@AWK@"
GREP_BIN             = "@GREP@"
IPCS_BIN             = "@IPCS@"
KILL_BIN             = "@KILL@"

RUN_IN_PLACE         = "@RUN_IN_PLACE@" == "yes"

LOCKFILE             = "/tmp/linuxcnc.lock"
KILL_TIMEOUT_STEPS   = 20


INIFILE = None
INI_DIR = None
NMLFILE = None
HALCMD_ARGV = ["halcmd"]
DASHK = False
DEBUG_FILE = None
PRINT_FILE = None
_exit_result = 0
_debug_trace = False
_runtests = False
_error_check_registered = False
_signal_handled = False


def is_tty():
    return sys.stdin.isatty()


def have_display():
    return bool(os.environ.get("DISPLAY"))


def program_available(name):
    return shutil.which(name) is not None


def debug_trace(argv):
    if _debug_trace:
        line = "+ " + " ".join(shlex.quote(a) for a in argv)
        print(line, file=sys.stderr)


def run(argv, **kw):
    debug_trace(argv)
    return subprocess.run(argv, **kw)


def popen(argv, **kw):
    debug_trace(argv)
    return subprocess.Popen(argv, **kw)


def _append(path, text):
    if path is None:
        return
    try:
        with open(path, "a") as f:
            f.write(text)
    except OSError:
        pass


def log_debug(msg):
    if DEBUG_FILE is None:
        print(msg, file=sys.stderr)
    else:
        _append(DEBUG_FILE, msg + "\n")


def log_print(msg):
    if PRINT_FILE is None:
        print(msg)
    else:
        _append(PRINT_FILE, msg + "\n")


def prepend_env(name, value, sep=os.pathsep):
    cur = os.environ.get(name, "")
    os.environ[name] = value + sep + cur if cur else value


def die(msg, code=1):
    print(msg, file=sys.stderr)
    global _error_check_registered
    if _error_check_registered:
        try:
            atexit.unregister(error_check)
        except Exception:
            pass
        _error_check_registered = False
    sys.exit(code)


def rip_self_reexec():
    if not RUN_IN_PLACE:
        return
    if os.environ.get("EMC2_HOME") == EMC2_HOME:
        return
    rip_env = os.path.join(EMC2_HOME, "scripts", "rip-environment")
    os.execv(rip_env, [rip_env, "linuxcnc", *sys.argv[1:]])


def force_glx_backends():
    cur = os.environ.get("LINUXCNC_OPENGL_PLATFORM")
    if cur is None or cur == "glx":
        os.environ["PYOPENGL_PLATFORM"] = "x11"
        os.environ["GDK_BACKEND"] = "x11"
        os.environ["QT_QPA_PLATFORM"] = "xcb"


def setup_environment():
    os.environ["LINUXCNC_HOME"] = EMC2_HOME
    os.environ["LINUXCNCVERSION"] = LINUXCNCVERSION
    os.environ["HALLIB_DIR"] = HALLIB_DIR
    os.environ["HALLIB_PATH"] = "." + os.pathsep + HALLIB_DIR

    home = os.environ.get("HOME", "")
    if home:
        local_bin = os.path.join(home, ".local", "bin")
        if os.path.isdir(local_bin) and ".local/bin" not in os.environ.get("PATH", ""):
            prepend_env("PATH", local_bin)

    prepend_env("PATH", EMC2_BIN_DIR)
    scripts_dir = os.path.join(EMC2_HOME, "scripts")
    if os.path.isdir(scripts_dir):
        prepend_env("PATH", scripts_dir)

    if RUN_IN_PLACE:
        prepend_env("LD_LIBRARY_PATH", os.path.join(EMC2_HOME, "lib"))

    prepend_env("PYTHONPATH", os.path.join(EMC2_HOME, "lib", "python"))

    # In RIP mode the rip-environment wrapper owns TCLLIBPATH; setting it
    # here would double-stack the path.
    if not RUN_IN_PLACE:
        tcl_path = os.path.join(EMC2_HOME, "lib", "tcltk")
        cur = os.environ.get("TCLLIBPATH", "")
        os.environ["TCLLIBPATH"] = tcl_path + " " + cur if cur else tcl_path

    if RUN_IN_PLACE:
        os.environ["LINUXCNC_RIP_FLAG"] = "True"


def kernel_version_check():
    if not KERNEL_VERS:
        return
    running = os.uname().release
    if running == KERNEL_VERS:
        return
    msg = (
        f"LinuxCNC requires the real-time kernel {KERNEL_VERS} to run.\n"
        "Before running LinuxCNC, reboot and choose this kernel at the boot menu."
    )
    if is_tty() or not have_display():
        print(msg, file=sys.stderr)
    else:
        wish_error("Realtime Kernel Required", msg)
    sys.exit(1)


def inivar(*args):
    cmd = ["inivar", *args]
    debug_trace(cmd)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return None
    if r.returncode != 0:
        return None
    return r.stdout.rstrip("\n")


def get_ini(var, sec):
    val = inivar("-ini", INIFILE, "-var", var, "-sec", sec)
    log_print(f"{var}={val or ''}")
    return val or ""


def get_ini_tildeexpand(var, sec, num=None):
    args = ["-tildeexpand", "-ini", INIFILE, "-var", var, "-sec", sec]
    if num is not None:
        args += ["-num", str(num)]
    return inivar(*args) or ""


def get_ini_num(var, sec, num):
    return inivar("-ini", INIFILE, "-var", var, "-sec", sec, "-num", str(num)) or ""


def get_ini_ex(*args):
    """Try (var, section) pairs in order; a trailing odd arg is a default."""
    pairs = list(args)
    default = None
    if len(pairs) % 2 == 1:
        default = pairs[-1]
        pairs = pairs[:-1]
    first_label = None
    for i in range(0, len(pairs), 2):
        var, sec = pairs[i], pairs[i + 1]
        if first_label is None:
            first_label = f"[{sec}]{var}"
        val = inivar("-ini", INIFILE, "-var", var, "-sec", sec)
        if val is not None:
            return val
    if default is not None:
        return default
    die(f"Can't find {first_label} in {INIFILE}.")


def wish_yesno(title, message):
    script = (
        "wm wi .\n"
        f'puts [tk_messageBox -title "{title}" -message "{message}" -type yesno]\n'
        "exit\n"
    )
    try:
        r = subprocess.run([WISH], input=script, capture_output=True, text=True)
    except FileNotFoundError:
        return ""
    return r.stdout.strip()


def wish_error(title, message):
    script = (
        "wm wi .\n"
        "tk_messageBox -type ok -title LinuxCNC -icon error"
        f' -title "{title}"'
        f" -message {{{message}}}\n"
        "exit\n"
    )
    try:
        subprocess.run([WISH], input=script, capture_output=True, text=True)
    except FileNotFoundError:
        pass


def show_errors_gui(debug_path, print_path):
    tcl = os.path.join(EMC2_TCL_DIR, "show_errors.tcl")
    try:
        subprocess.run([WISH, tcl, debug_path, print_path])
    except FileNotFoundError:
        pass


def popimage_destroy():
    if not have_display():
        return
    script = "catch {send -async popimage destroy .}; destroy .\n"
    try:
        subprocess.run([WISH], input=script, capture_output=True, text=True, timeout=5)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


def pidof(name):
    try:
        r = subprocess.run([PIDOF_BIN, "-x", name], capture_output=True, text=True)
    except FileNotFoundError:
        return []
    if r.returncode != 0 or not r.stdout.strip():
        return []
    return [int(p) for p in r.stdout.split()]


def _ps_stat_comm(pid):
    try:
        r = subprocess.run(
            [PS_BIN, "-o", "stat=", "-o", "comm=", str(pid)],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        return ""
    return r.stdout.strip()


def is_alive(pid):
    st = _ps_stat_comm(pid)
    if not st:
        return False
    return not st.startswith("Z")


def kill_task(name, pids=None):
    if pids is None:
        pids = pidof(name)
    if not pids:
        log_debug(f"Could not find pid(s) for task {name}")
        return
    for pid in pids:
        st = _ps_stat_comm(pid)
        if st.startswith("Z"):
            log_print(f"Skipping defunct task {name}, PID={pid}")
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError:
            print(f"Could not kill task {name}, PID={pid}")
            continue
        waited = False
        for _ in range(KILL_TIMEOUT_STEPS - 1):
            if not is_alive(pid):
                waited = True
                break
            time.sleep(0.1)
        if waited:
            continue
        log_print("Timeout, trying kill -9")
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            continue
        for _ in range(KILL_TIMEOUT_STEPS - 1):
            if not is_alive(pid):
                break
            time.sleep(0.1)
        else:
            print(f"Could not kill task {name}, PID={pid}")


def parse_nml_shmkeys(path):
    try:
        with open(path) as f:
            for line in f:
                if line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 10 and parts[0] == "B" and parts[2] == "SHMEM":
                    yield parts[9]
    except OSError:
        return


def halcmd_comp_count():
    r = run(HALCMD_ARGV + ["list", "comp"],
            capture_output=True, text=True)
    return len(r.stdout.split()) if r.stdout else 0


def cleanup(other=False):
    print("Shutting down and cleaning up LinuxCNC...")

    for task in (
        "linuxcncpanel", "iosh", "linuxcncsh", "linuxcncrsh",
        "linuxcnctop", "mdi", "debuglevel", "gmoccapy", "gscreen",
    ):
        pids = pidof(task)
        if pids:
            log_debug(f"{task}: {' '.join(str(p) for p in pids)}")
            kill_task(task, pids)

    if program_available("axis-remote") and have_display():
        try:
            r = subprocess.run(["axis-remote", "--ping"],
                               capture_output=True, text=True)
            if r.returncode == 0:
                subprocess.run(["axis-remote", "--quit"],
                               capture_output=True, text=True)
        except FileNotFoundError:
            pass

    if other:
        print("Waiting for other session to finish exiting...", end="", flush=True)
        finished = False
        for _ in range(KILL_TIMEOUT_STEPS - 1):
            if not os.path.exists(LOCKFILE):
                print(" Ok")
                finished = True
                break
            time.sleep(0.1)
        if not finished:
            print("lockfile still not removed")
        return

    if INIFILE:
        shutdown = inivar("-ini", INIFILE, "-var", "SHUTDOWN", "-sec", "HAL")
        if shutdown:
            print("Running HAL shutdown script")
            run(HALCMD_ARGV + ["-f", shutdown])

    for task in ("linuxcncsvr", "milltask", "motion-logger"):
        pids = pidof(task)
        if pids:
            log_debug(f"{task}: {' '.join(str(p) for p in pids)}")
            kill_task(task, pids)

    log_debug("Stopping realtime threads")
    run(HALCMD_ARGV + ["stop"])
    log_debug("Unloading hal components")
    run(HALCMD_ARGV + ["unload", "all"])

    for _ in range(10):
        if halcmd_comp_count() <= 1:
            break
        time.sleep(0.2)

    log_print("Removing HAL_LIB, RTAPI, and Real Time OS modules")
    try:
        subprocess.run([REALTIME, "stop"])
    except FileNotFoundError:
        pass

    log_print("Removing NML shared memory segments")
    if NMLFILE and os.path.isfile(NMLFILE):
        for shmkey in parse_nml_shmkeys(NMLFILE):
            try:
                subprocess.run(["ipcrm", "-M", shmkey], capture_output=True)
            except FileNotFoundError:
                pass

    try:
        os.remove(LOCKFILE)
    except FileNotFoundError:
        pass


def split_app_items(raw):
    parts = shlex.split(raw, posix=True)
    if not parts:
        return None, []
    return parts[0], parts[1:]


def run_applications():
    first = get_ini_tildeexpand("APP", "APPLICATIONS", 1)
    if not first:
        return
    delay_raw = get_ini("DELAY", "APPLICATIONS")
    try:
        delay = float(delay_raw) if delay_raw else 0.0
    except ValueError:
        delay = 0.0

    num = 1
    while True:
        raw = get_ini_tildeexpand("APP", "APPLICATIONS", num)
        if not raw:
            break
        app_name, app_args = split_app_items(raw)
        if not app_name:
            num += 1
            continue

        if app_name.startswith("/"):
            exe = app_name
        elif app_name.startswith("./"):
            exe = os.path.join(os.getcwd(), app_name[2:])
        else:
            exe = os.path.join(os.getcwd(), app_name)
            if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
                exe = shutil.which(app_name) or ""

        if not exe or not os.path.isfile(exe):
            print(f"APP: Cannot find executable file for: <{app_name}>")
        elif not os.access(exe, os.X_OK):
            print(f"APP: File not executable: <{exe}>")
        else:
            print(f"APP: {app_name} found: <{exe}>")
            argv = [exe, *app_args]
            pid = os.fork()
            if pid == 0:
                try:
                    if delay > 0:
                        time.sleep(delay)
                    os.execvp(exe, argv)
                except Exception as e:
                    print(f"APP: exec failed: {e}", file=sys.stderr)
                    os._exit(1)
        num += 1


def find_hal_file(cfgfile, hallib_path):
    if cfgfile.startswith("LIB:"):
        leaf = cfgfile[4:]
        if not leaf:
            die(f"ILLFORMED LIB:file:<{cfgfile}>")
        found = os.path.join(HALLIB_DIR, leaf)
        if not os.access(found, os.R_OK):
            die(f"CANNOT READ LIB:file:{found}")
        return found, f"Found file(LIB): {found}"

    if cfgfile.startswith("/"):
        return cfgfile, f"Found file(ABS): {cfgfile}"

    for pathdir in hallib_path.split(":"):
        if not pathdir:
            continue
        candidate = os.path.join(pathdir, cfgfile)
        if os.access(candidate, os.R_OK):
            tag = "REL" if pathdir.startswith(".") else "lib"
            return candidate, f"Found file({tag}): {candidate}"

    die(f"CANNOT FIND FILE FOR:{cfgfile}")


def load_hal_files(hallib_path):
    twopass = get_ini_num("TWOPASS", "HAL", 1)
    if twopass:
        cfg = os.path.join(EMC2_TCL_LIB_DIR, "twopass.tcl")
        # twopass.tcl appends verbose output to PRINT_FILE when it exists.
        env = os.environ.copy()
        if PRINT_FILE:
            env["PRINT_FILE"] = PRINT_FILE
        r = run(["haltcl", "-i", INIFILE, cfg], env=env)
        if r.returncode != 0 and not DASHK:
            cleanup()
            sys.exit(1)
        return

    num = 1
    while True:
        raw = get_ini_tildeexpand("HALFILE", "HAL", num)
        if not raw:
            break
        tokens = shlex.split(raw, posix=True)
        cfgfile = tokens[0]
        cfgfile_args = tokens[1:]

        resolved, msg = find_hal_file(cfgfile, hallib_path)
        if os.path.isdir(resolved):
            die(f"CANNOT FIND FILE FOR:{cfgfile}")
        print(msg)

        if resolved.endswith(".tcl"):
            r = run(["haltcl", "-i", INIFILE, resolved, *cfgfile_args])
        else:
            r = run(HALCMD_ARGV + ["-i", INIFILE, "-f", resolved])

        if r.returncode != 0 and not DASHK:
            cleanup()
            sys.exit(1)
        num += 1


def load_hal_commands():
    num = 1
    while True:
        raw = get_ini_num("HALCMD", "HAL", num)
        if not raw:
            break
        log_print(f"Running HAL command: {raw}")
        try:
            argv = shlex.split(raw, posix=True)
        except ValueError:
            argv = raw.split()
        r = run(HALCMD_ARGV + argv)
        if r.returncode != 0 and not DASHK:
            print(f"INI file HAL command {raw} failed.")
            cleanup()
            sys.exit(1)
        num += 1


def wait_for_traj_init():
    deadline = time.monotonic() + 10
    while True:
        r = run(HALCMD_ARGV + ["getp", "ini.traj_max_velocity"],
                capture_output=True, text=True)
        try:
            val = float(r.stdout.strip())
        except (ValueError, AttributeError):
            val = 0.0
        if val != 0.0:
            return
        if time.monotonic() >= deadline:
            msg = "ini.traj_max_velocity still 0.0 after 10 seconds"
            print(msg)
            log_print(msg)
            log_debug(msg)
            return
        time.sleep(0.1)


def run_display(mode, display_args, extra_args):
    log_print(f"Starting DISPLAY program: {mode}")
    if mode == "tklinuxcnc":
        tcl_path = os.path.join(EMC2_TCL_DIR, f"{mode}.tcl")
        if not (os.path.isfile(tcl_path) and os.access(tcl_path, os.X_OK)):
            print(
                f"Can't execute DISPLAY program {tcl_path} "
                f"{' '.join(display_args)}"
            )
            cleanup()
            sys.exit(1)
        r = run([tcl_path, "-ini", INIFILE, *display_args])
        return r.returncode

    if mode == "dummy":
        print("DUMMY DISPLAY MODULE, press <ENTER> to continue.")
        try:
            input()
        except EOFError:
            pass
        return 0

    if mode == "linuxcncrsh":
        r = run([mode, *display_args, *extra_args, "--", "-ini", INIFILE])
        return r.returncode

    if not program_available(mode):
        joined = " ".join([mode, *display_args, *extra_args])
        print(f"Can't execute DISPLAY program {joined}")
        cleanup()
        sys.exit(1)
    r = run([mode, "-ini", INIFILE, *display_args, *extra_args])
    return r.returncode


def error_check():
    popimage_destroy()
    try:
        if _exit_result != 0:
            if is_tty() or not have_display():
                dst_dbg = os.path.expanduser("~/linuxcnc_debug.txt")
                dst_prn = os.path.expanduser("~/linuxcnc_print.txt")
                if DEBUG_FILE and os.path.isfile(DEBUG_FILE):
                    shutil.copy2(DEBUG_FILE, dst_dbg)
                else:
                    with open(dst_dbg, "w") as f:
                        f.write("(debug information was sent to stderr)\n")
                if PRINT_FILE and os.path.isfile(PRINT_FILE):
                    shutil.copy2(PRINT_FILE, dst_prn)
                else:
                    with open(dst_prn, "w") as f:
                        f.write("(print information was sent to stdout)\n")
                print(
                    "LinuxCNC terminated with an error.  You can find more "
                    "information in the log:\n"
                    f"    {dst_dbg}\n"
                    "and\n"
                    f"    {dst_prn}\n"
                    "as well as in the output of the shell command 'dmesg' "
                    "and in the terminal"
                )
            else:
                show_errors_gui(DEBUG_FILE or "", PRINT_FILE or "")
    finally:
        for path in (DEBUG_FILE, PRINT_FILE):
            if not path:
                continue
            try:
                os.remove(path)
            except OSError:
                pass


def print_usage():
    p = os.path.basename(sys.argv[0])
    print(
        f"{p}: Run LinuxCNC\n"
        "\n"
        "Usage:\n"
        f"  $ {p} -h\n"
        "    This help\n"
        "\n"
        f"  $ {p} [Options]\n"
        "    Choose the configuration INI file graphically\n"
        "\n"
        f"  $ {p} [Options] path/to/your_ini_file\n"
        "    Name the configuration INI file using its path\n"
        "\n"
        f"  $ {p} [Options] -l\n"
        "    Use the previously used configuration INI file\n"
        "\n"
        "Options:\n"
        "    -d: Turn on \"debug\" mode\n"
        "    -v: Turn on \"verbose\" mode\n"
        "    -r: Disable redirection of stdout and stderr to "
        "~/linuxcnc_print.txt and\n"
        "        ~/linuxcnc_debug.txt when stdin is not a tty.\n"
        "        Used when running linuxcnc tests non-interactively.\n"
        "    -l: Use the last-used INI file\n"
        "    -k: Continue in the presence of errors in HAL files\n"
        "    -t \"tpmodulename [parameters]\"\n"
        "            specify custom trajectory_planning_module\n"
        "            overrides optional INI setting [TRAJ]TPMOD\n"
        "    -m \"homemodulename [parameters]\"\n"
        "            specify custom homing_module\n"
        "            overrides optional INI setting [EMCMOT]HOMEMOD\n"
        f"    -H \"dirname\": search dirname for HAL files before searching\n"
        "                  INI directory and system library:\n"
        f"                  {HALLIB_DIR}\n"
        "Note:\n"
        "    The -H \"dirname\" option may be specified multiple times"
    )


def parse_args():
    try:
        opts, args = getopt.getopt(sys.argv[1:], "dvlhkrH:t:m:")
    except getopt.GetoptError as e:
        print(e, file=sys.stderr)
        print_usage()
        sys.exit(1)

    result = {
        "debug": False, "verbose": False, "runtests": False,
        "use_last": False, "dashk": False, "help": False,
        "H_dirs": [], "tpmod": None, "homemod": None,
    }
    for k, v in opts:
        if k == "-d":
            result["debug"] = True
        elif k == "-v":
            result["verbose"] = True
        elif k == "-r":
            result["runtests"] = True
        elif k == "-l":
            result["use_last"] = True
        elif k == "-k":
            result["dashk"] = True
        elif k == "-h":
            result["help"] = True
        elif k == "-H":
            if not os.path.isdir(v):
                print(f"Invalid dirname specified: -H {v}")
                sys.exit(1)
            result["H_dirs"].append(os.path.realpath(v))
        elif k == "-t":
            result["tpmod"] = v
        elif k == "-m":
            result["homemod"] = v

    inifile = None
    extra = []
    if args:
        inifile = args[0]
        extra = args[1:]
    return result, inifile, extra


def _signal_cleanup(signum, frame):
    global _signal_handled
    if _signal_handled:
        return
    _signal_handled = True
    try:
        cleanup()
    finally:
        sys.exit(0)


def _resolve_inifile(ini_arg, use_last):
    if ini_arg:
        if ini_arg == "-":
            use_last = True
        elif os.path.isabs(ini_arg):
            return ini_arg, use_last
        else:
            return os.path.join(os.getcwd(), ini_arg), use_last

    if use_last:
        val = inivar("-ini", os.path.expanduser("~/.linuxcncrc"),
                     "-var", "LAST_CONFIG", "-sec", "PICKCONFIG")
        if val:
            log_print(f"Using previous INI file: {val}")
            return val, use_last
        return "", use_last

    pickconfig = os.path.join(EMC2_TCL_DIR, "bin", "pickconfig.tcl")
    try:
        r = subprocess.run([WISH, pickconfig], capture_output=True, text=True)
    except FileNotFoundError:
        return "", use_last
    picked = r.stdout.strip()
    if picked.endswith(".demo"):
        subprocess.Popen([picked])
        sys.exit(0)
    return picked, use_last


def _start_intro_graphic():
    img = get_ini("INTRO_GRAPHIC", "DISPLAY")
    imgtime = get_ini("INTRO_TIME", "DISPLAY") or "5"
    if not img:
        return
    for candidate in (img, os.path.join(INI_DIR, img),
                      os.path.join(EMC2_IMAGE_DIR, img)):
        if os.path.isfile(candidate):
            img = candidate
            break
    else:
        return
    popbin = os.path.join(EMC2_TCL_DIR, "bin", "popimage")
    if os.path.isfile(popbin) and os.access(popbin, os.X_OK):
        try:
            popen([popbin, img, imgtime])
        except FileNotFoundError:
            pass


def main():
    global DEBUG_FILE, PRINT_FILE, INIFILE, INI_DIR, NMLFILE
    global HALCMD_ARGV, DASHK, _debug_trace, _runtests
    global _error_check_registered, _exit_result

    # Line-buffer stdio so launcher prints interleave correctly with
    # child-process writes to the same fd; block-buffered pipe writes
    # would otherwise land after all the child output.
    try:
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except AttributeError:
        pass

    rip_self_reexec()
    force_glx_backends()
    setup_environment()

    fd, DEBUG_FILE = tempfile.mkstemp(prefix="linuxcnc.debug.", dir="/tmp")
    os.close(fd)
    fd, PRINT_FILE = tempfile.mkstemp(prefix="linuxcnc.print.", dir="/tmp")
    os.close(fd)

    opts, ini_arg, extra_args = parse_args()

    if opts["help"]:
        print_usage()
        for p in (DEBUG_FILE, PRINT_FILE):
            try:
                os.remove(p)
            except OSError:
                pass
        sys.exit(0)

    if opts["debug"] and is_tty():
        _debug_trace = True
        try:
            os.remove(DEBUG_FILE)
        except OSError:
            pass
        DEBUG_FILE = None
        print("Debug mode on", file=sys.stderr)

    if opts["verbose"] and is_tty():
        try:
            os.remove(PRINT_FILE)
        except OSError:
            pass
        PRINT_FILE = None
        print("Verbose mode on")

    _runtests = opts["runtests"]
    DASHK = opts["dashk"]
    if DASHK:
        HALCMD_ARGV = ["halcmd", "-k"]

    hallib_path = os.environ.get("HALLIB_PATH", "." + os.pathsep + HALLIB_DIR)
    for d in opts["H_dirs"]:
        hallib_path = d + ":" + hallib_path
        print(f"HALLIB_PATH = {hallib_path}")
    os.environ["HALLIB_PATH"] = hallib_path

    kernel_version_check()

    # After dup2 the Python file objects still point at the original fds,
    # so children launched via subprocess inherit the redirected destinations.
    if not _runtests and not is_tty():
        if DEBUG_FILE:
            sys.stderr.flush()
            dbg_fd = os.open(DEBUG_FILE, os.O_WRONLY | os.O_APPEND)
            os.dup2(dbg_fd, 2)
            os.close(dbg_fd)
        if PRINT_FILE:
            sys.stdout.flush()
            prn_fd = os.open(PRINT_FILE, os.O_WRONLY | os.O_APPEND)
            os.dup2(prn_fd, 1)
            os.close(prn_fd)

    atexit.register(error_check)
    _error_check_registered = True

    INIFILE, _ = _resolve_inifile(ini_arg, opts["use_last"])
    if not INIFILE:
        atexit.unregister(error_check)
        _error_check_registered = False
        for p in (DEBUG_FILE, PRINT_FILE):
            if p:
                try:
                    os.remove(p)
                except OSError:
                    pass
        sys.exit(0)

    INI_DIR = os.path.dirname(INIFILE)
    ini_name = os.path.basename(INIFILE)
    os.environ["CONFIG_DIR"] = INI_DIR
    prepend_env("PATH", os.path.join(INI_DIR, "bin"))

    log_print(f"RUN_IN_PLACE={'yes' if RUN_IN_PLACE else 'no'}")

    os.environ["LINUXCNC_TCL_DIR"]     = EMC2_TCL_DIR
    os.environ["LINUXCNC_EMCSH"]       = WISH
    os.environ["LINUXCNC_HELP_DIR"]    = EMC2_HELP_DIR
    os.environ["LINUXCNC_LANG_DIR"]    = EMC2_LANG_DIR
    os.environ["REALTIME"]             = REALTIME
    os.environ["HALCMD"]               = " ".join(HALCMD_ARGV)
    os.environ["LINUXCNC_NCFILES_DIR"] = EMC2_NCFILES_DIR

    log_print(f"LINUXCNC_DIR={os.environ.get('LINUXCNC_DIR', '')}")
    log_print(f"LINUXCNC_BIN_DIR={EMC2_BIN_DIR}")
    log_print(f"LINUXCNC_TCL_DIR={EMC2_TCL_DIR}")
    log_print(f"LINUXCNC_RTLIB_DIR={EMC2_RTLIB_DIR}")
    log_print(f"LINUXCNC_LANG_DIR={EMC2_LANG_DIR}")
    log_print("INIVAR=inivar")
    log_print(f"HALCMD={' '.join(HALCMD_ARGV)}")
    log_print(f"LINUXCNC_EMCSH={WISH}")

    if not _runtests:
        print(f"LINUXCNC - {LINUXCNCVERSION}")
        print(f"Machine configuration directory is '{INI_DIR}'")
    print(f"Machine configuration file is '{ini_name}'")

    if not os.path.isfile(INIFILE):
        print(f"Could not find INI file '{INIFILE}'")
        atexit.unregister(error_check)
        _error_check_registered = False
        for p in (DEBUG_FILE, PRINT_FILE):
            if p:
                try:
                    os.remove(p)
                except OSError:
                    pass
        sys.exit(1)
    log_print(f"INIFILE={INIFILE}")

    version = get_ini("VERSION", "EMC")
    if version != "1.1":
        if not have_display():
            die("INI file [EMC]VERSION indicates update is needed, but the "
                "update GUI can't run without an X display")
        r = run(["update_ini", "-d", INIFILE])
        if r.returncode == 42:
            print("update_ini cancelled by user")
            sys.exit(0)
        if r.returncode != 0:
            die(f"update script failed in an unexpected way "
                f"(exit {r.returncode}).", code=r.returncode)

    r = run([TCLSH, os.path.join(HALLIB_DIR, "check_config.tcl"), INIFILE])
    if r.returncode == 1:
        die("check_config validation failed", code=r.returncode)
    if r.returncode != 0:
        die(f"check_config validation failed in an unexpected way.",
            code=r.returncode)

    get_ini("PARAMETER_FILE", "RS274NGC")

    emcmot_base = get_ini_ex("MOT", "MOT", "EMCMOT", "EMCMOT", "motmod")
    emcmot = emcmot_base + MODULE_EXT

    tpmod = opts["tpmod"] or inivar("-ini", INIFILE, "-var", "TPMOD",
                                     "-sec", "TRAJ") or "tpmod"
    homemod = opts["homemod"] or inivar("-ini", INIFILE, "-var", "HOMEMOD",
                                         "-sec", "EMCMOT") or "homemod"

    emctask = get_ini("TASK", "TASK")
    if emctask == "emctask":
        emctask = "linuxcnctask"

    emcserver = "linuxcncsvr"

    halui = inivar("-ini", INIFILE, "-var", "HALUI", "-sec", "HAL") or ""
    halbridge = inivar("-ini", INIFILE, "-var", "HALBRIDGE", "-sec", "HAL") or ""

    display_raw = get_ini("DISPLAY", "DISPLAY")
    display_tokens = display_raw.split() if display_raw else []
    emcdisplay = display_tokens[0] if display_tokens else ""
    emcdisplay_args = display_tokens[1:]
    if emcdisplay == "tkemc":
        emcdisplay = "tklinuxcnc"

    NMLFILE = get_ini_ex("NML_FILE", "LINUXCNC", "NML_FILE", "EMC",
                         DEFAULT_NMLFILE)
    os.environ["NMLFILE"] = NMLFILE

    os.environ["TRAJ_COORDINATES"] = get_ini("COORDINATES", "TRAJ")
    os.environ["KINS_KINEMATICS"] = get_ini("KINEMATICS", "KINS")

    if os.path.exists(LOCKFILE):
        if is_tty():
            try:
                reply = input("LinuxCNC is still running.  Restart it? [Y/n] ")
            except (EOFError, KeyboardInterrupt):
                reply = "n"
            reply = reply.strip() or "y"
        elif not have_display():
            print("No display, no tty, trying to clean up other instance "
                  "automatically")
            reply = "y"
        else:
            reply = wish_yesno("LinuxCNC",
                               "LinuxCNC is still running.  Restart it?")
        if reply.lower() in ("y", "yes"):
            print("Cleaning up old LinuxCNC...")
            cleanup(other=True)
        else:
            print("Not starting new LinuxCNC")
            sys.exit(0)

    print("Starting LinuxCNC...")

    # Installing the signal handler after the lockfile prompt avoids racing
    # KeyboardInterrupt from input() against cleanup.
    signal.signal(signal.SIGINT, _signal_cleanup)
    signal.signal(signal.SIGTERM, _signal_cleanup)

    try:
        os.chdir(INI_DIR)
    except OSError:
        print(f"E: Could not change directory to '{INI_DIR}'")
        sys.exit(1)

    open(LOCKFILE, "w").close()

    _start_intro_graphic()

    log_print(f"Starting LinuxCNC server program: {emcserver}")
    if not program_available(emcserver):
        print(f"Can't execute server program {emcserver}")
        cleanup()
        sys.exit(1)
    os.environ["INI_FILE_NAME"] = INIFILE
    # linuxcncsvr self-detaches; run it synchronously.
    run([emcserver, "-ini", INIFILE])

    log_print("Loading Real Time OS, RTAPI, and HAL_LIB modules")
    r = run([REALTIME, "start"])
    if r.returncode != 0:
        print("Realtime system did not load")
        cleanup()
        sys.exit(1)

    os.environ["HAL_RTMOD_DIR"] = EMC2_RTLIB_DIR
    emcmot_name = emcmot_base
    print(f"{os.path.basename(sys.argv[0])} TPMOD={tpmod} HOMEMOD={homemod} "
          f"EMCMOT={emcmot_name}")
    run(HALCMD_ARGV + ["loadrt", *shlex.split(tpmod, posix=True)])
    run(HALCMD_ARGV + ["loadrt", *shlex.split(homemod, posix=True)])

    log_print(f"Starting TASK program: {emctask}")
    if not program_available(emctask):
        print(f"Can't execute TASK program {emctask}")
        cleanup()
        sys.exit(1)
    # The inihal loadusr is intentionally invoked with bare `halcmd`:
    # -k is never honored for this call even when the user passed -k.
    run(["halcmd", "loadusr", "-Wn", "inihal", emctask, "-ini", INIFILE])

    if halui:
        log_print(f"Starting HAL User Interface program: {halui}")
        if not program_available(halui):
            print(f"Can't execute halui program {halui}")
            cleanup()
            sys.exit(1)
        run(HALCMD_ARGV + ["loadusr", "-Wn", "halui", halui, "-ini", INIFILE])

    if halbridge:
        log_print(f"Starting HAL User Interface program: {halbridge}")
        bridge_argv = shlex.split(halbridge, posix=True)
        run(HALCMD_ARGV + ["loadusr", "-Wn", "bridge", *bridge_argv])

    load_hal_files(hallib_path)
    load_hal_commands()

    run(HALCMD_ARGV + ["start"])

    run_applications()

    wait_for_traj_init()

    result = run_display(emcdisplay, emcdisplay_args, extra_args)

    _exit_result = result
    try:
        cleanup()
    except Exception as e:
        print(f"cleanup: {e}", file=sys.stderr)
    sys.exit(result)


if __name__ == "__main__":
    main()
